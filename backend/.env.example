# Database Configuration (Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key

# AI Configuration (Fallback if DB keys fail)
GEMINI_API_KEY=your-gemini-api-key
# OPENROUTER_API_KEY=your-openrouter-key # Optional

# Embedding Configuration (OpenRouter-compatible vector search)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=your-openrouter-key
EMBEDDING_ACCESS_MODE=openai_compatible

# Facebook Configuration
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_GRAPH_VERSION=v22.0
VERIFY_TOKEN=your-verify-token
INSTAGRAM_VERIFY_TOKEN=your-instagram-verify-token
WHATSAPP_OFFICIAL_VERIFY_TOKEN=your-official-whatsapp-verify-token

# Shopify read-only catalog integration (optional)
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_ENCRYPTION_KEY=base64-encoded-32-byte-key
SHOPIFY_APP_URL=https://your-frontend.example.com
SHOPIFY_REDIRECT_URI=https://your-backend.example.com/api/shopify/callback
SHOPIFY_API_VERSION=2026-01

# Port
PORT=3001
