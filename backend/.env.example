# Database Configuration (Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key

# AI Configuration (Fallback if DB keys fail)
GEMINI_API_KEY=your-gemini-api-key
# OPENROUTER_API_KEY=your-openrouter-key # Optional

# Embedding Configuration (Optional env override for vector search)
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=your-openrouter-key
# EMBEDDING_ACCESS_MODE=openai_compatible

# Facebook Configuration
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_GRAPH_VERSION=v22.0
VERIFY_TOKEN=your-verify-token
WHATSAPP_OFFICIAL_VERIFY_TOKEN=your-official-whatsapp-verify-token

# WhatsApp Configuration (Optional)
WAHA_BASE_URL=https://wahubbd.salesmanchatbot.online
WAHA_API_KEY=your-waha-api-key
WHATSAPP_DEFAULT_ENGINE=WEBJS

# Port
PORT=3001
